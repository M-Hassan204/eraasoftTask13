@model IEnumerable<eraasoftTask13.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 text-800"><span class="fas fa-tags me-2 text-info"></span>Categories</h3>
        <p class="mb-0 text-600">Manage movie categories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <span class="fas fa-plus me-2"></span>Add Category
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <span class="fas fa-check-circle me-2"></span>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    @foreach (var cat in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm overflow-hidden cinema-card">
                <div class="position-relative">
                    @if (!string.IsNullOrWhiteSpace(cat.Image))
                    {
                        <img src="@cat.Image" alt="@cat.Name"
                             class="card-img-top" style="height:200px;object-fit:cover;"
                             onerror="this.src='/img/placeholder-category.svg'" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-soft-info" style="height:200px;">
                            <span class="fas fa-tag text-info" style="font-size:64px;"></span>
                        </div>
                    }
                    <div class="position-absolute top-0 end-0 m-2">
                        @if (cat.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                    <div class="position-absolute top-0 start-0 m-2">
                        <span class="badge bg-info fs-10">
                            <span class="fas fa-film me-1"></span>@cat.Movies.Count movies
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold text-900 mb-1">@cat.Name</h5>
                    <p class="card-text text-600 small mb-0" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                        @(string.IsNullOrWhiteSpace(cat.Description) ? "No description." : cat.Description)
                    </p>
                </div>
                <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3">
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@cat.Id" class="btn btn-sm btn-falcon-default flex-grow-1">
                            <span class="fas fa-eye me-1"></span>Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-falcon-primary flex-grow-1">
                            <span class="fas fa-pencil me-1"></span>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-falcon-danger">
                            <span class="fas fa-trash"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card text-center py-5">
                <div class="card-body">
                    <span class="fas fa-tags text-300 mb-3" style="font-size:64px;display:block;"></span>
                    <h5 class="text-600">No categories yet</h5>
                    <a asp-action="Create" class="btn btn-primary mt-2">Add Category</a>
                </div>
            </div>
        </div>
    }
</div>
