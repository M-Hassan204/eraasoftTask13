@model eraasoftTask13.Models.Actor
@{
    ViewData["Title"] = Model.Name;
    var movies = Model.MovieActors.Select(ma => ma.Movie).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Actors</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-falcon-primary btn-sm">
            <span class="fas fa-pencil me-1"></span>Edit
        </a>
        <a asp-action="Index" class="btn btn-falcon-default btn-sm">
            <span class="fas fa-arrow-left me-1"></span>Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm text-center overflow-hidden">
            @if (!string.IsNullOrWhiteSpace(Model.Image))
            {
                <img src="@Model.Image" alt="@Model.Name" class="card-img-top"
                     style="height:350px;object-fit:cover;object-position:top;"
                     onerror="this.src='/img/placeholder-actor.svg'" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-300" style="height:350px;">
                    <span class="fas fa-user-circle text-400" style="font-size:100px;"></span>
                </div>
            }
            <div class="card-body">
                <h4 class="fw-bold text-900 mb-1">@Model.Name</h4>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success mb-2">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary mb-2">Inactive</span>
                }
                <p class="text-600 small mb-0">Member since @Model.CreatedAt.ToString("MMM yyyy")</p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><span class="fas fa-user me-2 text-primary"></span>Biography</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="text-700 mb-0">@Model.Bio</p>
                }
                else
                {
                    <p class="text-400 fst-italic mb-0">No biography available.</p>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <h5 class="mb-0"><span class="fas fa-film me-2 text-warning"></span>Movies</h5>
                <span class="badge bg-primary">@movies.Count</span>
            </div>
            @if (movies.Any())
            {
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Movie</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movie in movies)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrWhiteSpace(movie.MainImage))
                                                {
                                                    <img src="@movie.MainImage" alt="@movie.Name"
                                                         class="rounded me-2" style="width:40px;height:40px;object-fit:cover;"
                                                         onerror="this.src='/img/placeholder-movie.svg'" />
                                                }
                                                <span class="fw-semibold">@movie.Name</span>
                                            </div>
                                        </td>
                                        <td><span class="text-600">@movie?.Category?.Name</span></td>
                                        <td>
                                            @{
                                                var statusClass = movie.Status == eraasoftTask13.Models.MovieStatus.NowShowing
                                                    ? "bg-success" : movie.Status == eraasoftTask13.Models.MovieStatus.ComingSoon
                                                    ? "bg-info" : "bg-secondary";
                                            }
                                            <span class="badge @statusClass">@movie.Status</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
                                               class="btn btn-sm btn-falcon-default">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card-body text-center py-4">
                    <span class="fas fa-film text-300 mb-2" style="font-size:32px;display:block;"></span>
                    <p class="text-500 mb-0">No movies assigned yet.</p>
                </div>
            }
        </div>
    </div>
</div>
