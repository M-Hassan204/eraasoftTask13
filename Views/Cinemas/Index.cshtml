@model IEnumerable<eraasoftTask13.Models.Cinema>
@{
    ViewData["Title"] = "Cinemas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 text-800"><span class="fas fa-film me-2 text-danger"></span>Cinemas</h3>
        <p class="mb-0 text-600">Manage all cinema locations</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <span class="fas fa-plus me-2"></span>Add Cinema
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <span class="fas fa-check-circle me-2"></span>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    @foreach (var cinema in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm overflow-hidden cinema-card">
                <div class="position-relative">
                    @if (!string.IsNullOrWhiteSpace(cinema.Image))
                    {
                        <img src="@cinema.Image" alt="@cinema.Name"
                             class="card-img-top" style="height:220px;object-fit:cover;"
                             onerror="this.src='/img/placeholder-cinema.svg'" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-soft-danger" style="height:220px;">
                            <span class="fas fa-building text-danger" style="font-size:64px;"></span>
                        </div>
                    }
                    <div class="position-absolute top-0 end-0 m-2">
                        @if (cinema.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold text-900 mb-1">@cinema.Name</h5>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <span class="text-600 small"><span class="fas fa-map-marker-alt me-1 text-danger"></span>@cinema.City</span>
                        <span class="text-600 small"><span class="fas fa-th me-1 text-primary"></span>@cinema.Halls.Count halls</span>
                        <span class="text-600 small"><span class="fas fa-film me-1 text-warning"></span>@cinema.Movies.Count movies</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(cinema.Address))
                    {
                        <p class="text-600 small mb-0"><span class="fas fa-location-dot me-1"></span>@cinema.Address</p>
                    }
                </div>
                <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3">
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@cinema.Id" class="btn btn-sm btn-falcon-default flex-grow-1">
                            <span class="fas fa-eye me-1"></span>Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@cinema.Id" class="btn btn-sm btn-falcon-primary flex-grow-1">
                            <span class="fas fa-pencil me-1"></span>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@cinema.Id" class="btn btn-sm btn-falcon-danger">
                            <span class="fas fa-trash"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card text-center py-5">
                <div class="card-body">
                    <span class="fas fa-building text-300 mb-3" style="font-size:64px;display:block;"></span>
                    <h5 class="text-600">No cinemas yet</h5>
                    <a asp-action="Create" class="btn btn-primary mt-2">Add Cinema</a>
                </div>
            </div>
        </div>
    }
</div>
