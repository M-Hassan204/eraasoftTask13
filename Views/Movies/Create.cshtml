@model eraasoftTask13.ViewModels.MovieCreateViewModel
@{
    ViewData["Title"] = "Add Movie";
    var actors = ViewData["Actors"] as List<eraasoftTask13.Models.Actor> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-800"><span class="fas fa-plus-circle me-2 text-warning"></span>Add New Movie</h3>
    <a asp-action="Index" class="btn btn-falcon-default"><span class="fas fa-arrow-left me-2"></span>Back</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">

            <!-- Basic Information -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><span class="fas fa-info-circle me-2 text-warning"></span>Basic Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Movie title" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Synopsis..."></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select"
                                    asp-items="Html.GetEnumSelectList<eraasoftTask13.Models.MovieStatus>()"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReleaseDate" class="form-label fw-semibold"></label>
                            <input asp-for="ReleaseDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DurationInMinutes" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DurationInMinutes" class="form-control" type="number" min="1" max="999" />
                                <span class="input-group-text">min</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                </div>
            </div>

            <!-- Classification -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><span class="fas fa-layer-group me-2 text-info"></span>Classification</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CinemaId" class="form-label fw-semibold"></label>
                            <select asp-for="CinemaId" class="form-select" asp-items="ViewBag.CinemaId">
                                <option value="">-- Select Cinema --</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Actors</label>
                        <div class="row g-2">
                            @foreach (var actor in actors)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedActorIds" value="@actor.Id"
                                               id="actor_@actor.Id" />
                                        <label class="form-check-label" for="actor_@actor.Id">
                                            @actor.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Images -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><span class="fas fa-images me-2 text-warning"></span>Movie Images</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <label asp-for="MainImageFile" class="form-label fw-semibold">Main Poster</label>
                        <input asp-for="MainImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" id="mainImageInput" />
                        <span asp-validation-for="MainImageFile" class="text-danger small"></span>
                        <div class="form-text">The primary movie poster shown in listings.</div>
                        <div id="mainPreviewWrapper" class="d-none mt-3">
                            <img id="mainPreview" src="#" alt="Main Preview"
                                 class="rounded shadow-sm" style="max-height:220px;object-fit:cover;" />
                        </div>
                    </div>
                    <hr />
                    <div>
                        <label asp-for="SubImageFiles" class="form-label fw-semibold">Gallery Images <span class="text-muted fw-normal">(optional, select multiple)</span></label>
                        <input asp-for="SubImageFiles" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp"
                               id="subImagesInput" multiple />
                        <div class="form-text">Hold Ctrl / Cmd to select multiple images at once.</div>
                        <div id="subPreviewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm bg-soft-warning sticky-top" style="top:80px;">
                <div class="card-body">
                    <h6 class="text-warning mb-3"><span class="fas fa-lightbulb me-2"></span>Tips</h6>
                    <ul class="list-unstyled text-600 small mb-0">
                        <li class="mb-2"><span class="fas fa-check text-success me-2"></span>Use portrait (poster) format for main image</li>
                        <li class="mb-2"><span class="fas fa-check text-success me-2"></span>Gallery images can be landscape scenes</li>
                        <li class="mb-2"><span class="fas fa-check text-success me-2"></span>Select multiple gallery images at once</li>
                        <li><span class="fas fa-check text-success me-2"></span>Max 10 MB per image</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="submit" class="btn btn-primary px-4"><span class="fas fa-save me-2"></span>Create Movie</button>
        <a asp-action="Index" class="btn btn-falcon-default">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Main image preview
        document.getElementById('mainImageInput').addEventListener('change', function () {
            const w = document.getElementById('mainPreviewWrapper');
            const p = document.getElementById('mainPreview');
            if (this.files && this.files[0]) {
                const r = new FileReader();
                r.onload = e => { p.src = e.target.result; w.classList.remove('d-none'); };
                r.readAsDataURL(this.files[0]);
            } else { w.classList.add('d-none'); }
        });

        // Sub images preview
        document.getElementById('subImagesInput').addEventListener('change', function () {
            const container = document.getElementById('subPreviewContainer');
            container.innerHTML = '';
            Array.from(this.files).forEach(file => {
                const r = new FileReader();
                r.onload = e => {
                    const div = document.createElement('div');
                    div.className = 'position-relative';
                    div.innerHTML = `<img src="${e.target.result}" alt="preview"
                        class="rounded shadow-sm" style="width:100px;height:100px;object-fit:cover;" />`;
                    container.appendChild(div);
                };
                r.readAsDataURL(file);
            });
        });
    </script>
}
