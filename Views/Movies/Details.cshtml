@model eraasoftTask13.Models.Movie
@{
    ViewData["Title"] = Model.Name;
    var actors = Model.MovieActors.Select(ma => ma.Actor).ToList();
    var subImages = Model.MovieImages.Where(i => !i.IsMain).OrderBy(i => i.DisplayOrder).ToList();
    var upcomingShows = Model.ShowTimes.Where(s => s.StartTime > DateTime.Now).OrderBy(s => s.StartTime).ToList();
    var statusClass = Model.Status == eraasoftTask13.Models.MovieStatus.NowShowing ? "bg-success"
        : Model.Status == eraasoftTask13.Models.MovieStatus.ComingSoon ? "bg-info" : "bg-secondary";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Movies</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-falcon-primary btn-sm">
            <span class="fas fa-pencil me-1"></span>Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-falcon-danger btn-sm">
            <span class="fas fa-trash me-1"></span>Delete
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Main Poster & Quick Info -->
    <div class="col-lg-4">
        <div class="card shadow-sm overflow-hidden sticky-top" style="top:80px;">
            @if (!string.IsNullOrWhiteSpace(Model.MainImage))
            {
                <img src="@Model.MainImage" alt="@Model.Name" class="card-img-top"
                     style="height:380px;object-fit:cover;"
                     onerror="this.src='/img/placeholder-movie.svg'" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-soft-warning" style="height:380px;">
                    <span class="fas fa-film text-warning" style="font-size:80px;"></span>
                </div>
            }
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h4 class="fw-bold text-900 mb-0">@Model.Name</h4>
                    <span class="badge @statusClass ms-2 flex-shrink-0">
                        @Model.Status.ToString().Replace("NowShowing","Now Showing").Replace("ComingSoon","Coming Soon")
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-2 text-600 small">
                    <span><span class="fas fa-tag me-1 text-info"></span>@Model.Category?.Name</span>
                    <span><span class="fas fa-building me-1 text-danger"></span>@Model.Cinema?.Name</span>
                    <span><span class="fas fa-clock me-1 text-warning"></span>@Model.DurationInMinutes min</span>
                    <span><span class="fas fa-calendar me-1 text-primary"></span>@Model.ReleaseDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Description -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><span class="fas fa-align-left me-2 text-primary"></span>Synopsis</h5>
            </div>
            <div class="card-body">
                <p class="text-700 mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description available." : Model.Description)</p>
            </div>
        </div>

        <!-- Actors -->
        @if (actors.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><span class="fas fa-star me-2 text-warning"></span>Cast</h5>
                    <span class="badge bg-warning text-dark">@actors.Count actors</span>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var actor in actors)
                        {
                            <a asp-controller="Actors" asp-action="Details" asp-route-id="@actor.Id"
                               class="text-decoration-none text-center">
                                @if (!string.IsNullOrWhiteSpace(actor.Image))
                                {
                                    <img src="@actor.Image" alt="@actor.Name"
                                         class="rounded-circle mb-1 shadow-sm" style="width:70px;height:70px;object-fit:cover;object-position:top;"
                                         onerror="this.src='/img/placeholder-actor.svg'" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-300 d-flex align-items-center justify-content-center mb-1"
                                         style="width:70px;height:70px;">
                                        <span class="fas fa-user text-400" style="font-size:28px;"></span>
                                    </div>
                                }
                                <p class="text-700 small mb-0 fw-semibold" style="max-width:80px;">@actor.Name</p>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Gallery -->
        @if (subImages.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><span class="fas fa-images me-2 text-info"></span>Gallery</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var img in subImages)
                        {
                            <div class="col-6 col-md-4">
                                <a href="@img.ImagePath" target="_blank" class="d-block">
                                    <img src="@img.ImagePath" alt="Gallery Image"
                                         class="img-fluid rounded shadow-sm gallery-img" style="height:150px;width:100%;object-fit:cover;"
                                         onerror="this.src='/img/placeholder-movie.svg'" />
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Upcoming ShowTimes -->
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><span class="fas fa-calendar-alt me-2 text-success"></span>Upcoming Showtimes</h5>
                <span class="badge bg-success">@upcomingShows.Count</span>
            </div>
            @if (upcomingShows.Any())
            {
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Hall</th>
                                    <th>Price</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var show in upcomingShows)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@show.StartTime.ToString("dd MMM yyyy")</span>
                                            <span class="text-600 small d-block">@show.StartTime.ToString("HH:mm") – @show.EndTime.ToString("HH:mm")</span>
                                        </td>
                                        <td>@show.Hall?.Name</td>
                                        <td><span class="badge bg-soft-success text-success fw-bold">@show.TicketPrice.ToString("C")</span></td>
                                        <td>
                                            <a asp-controller="Bookings" asp-action="Book" asp-route-showTimeId="@show.Id"
                                               class="btn btn-sm btn-success">Book Now</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card-body text-center py-4">
                    <span class="fas fa-calendar-times text-300 mb-2" style="font-size:32px;display:block;"></span>
                    <p class="text-500 mb-0">No upcoming showtimes.</p>
                </div>
            }
        </div>
    </div>
</div>
